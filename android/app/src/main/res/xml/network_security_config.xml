<?xml version="1.0" encoding="utf-8"?>
<!-- The prototype makes no network requests at all. This locks that in:
     if a future build adds one, it must be TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
